    n12 -> n14 [label="1"];
    n15 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#2C3E50"><FONT COLOR="#FFFFFF"><B>q6</B></FONT></TD></TR><TR><TD BGCOLOR="#EBF5FB">L1<BR/><FONT POINT-SIZE="10">Tag: 1</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
    n16 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#2C3E50"><FONT COLOR="#FFFFFF"><B>q7</B></FONT></TD></TR><TR><TD BGCOLOR="#EBF5FB">L2<BR/><FONT POINT-SIZE="10">Tag: 2</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
