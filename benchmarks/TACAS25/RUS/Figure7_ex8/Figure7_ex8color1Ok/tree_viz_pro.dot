digraph LSTA {
    node [shape=box, style="filled,rounded", fontname="Arial", fillcolor="#f0f0f0"];
    edge [fontname="Arial"];
    rankdir=TB;
    splines=polyline;
    n1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#2C3E50"><FONT COLOR="#FFFFFF"><B>q0</B></FONT></TD></TR><TR><TD BGCOLOR="#EBF5FB">L1<BR/><FONT POINT-SIZE="10">Tag: 1</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
