    n1 -> n2 [label="0"];
    n3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7D6608"><FONT COLOR="#FFFFFF"><B>q9</B></FONT></TD></TR><TR><TD BGCOLOR="#FEF9E7">3 /8 + i * ( sqrt2 *-1/8 )<BR/><FONT POINT-SIZE="10">Tag: 1</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
