    n1 -> n5 [label="1"];
    n6 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7D6608"><FONT COLOR="#FFFFFF"><B>q11</B></FONT></TD></TR><TR><TD BGCOLOR="#FEF9E7">i * ( -1/8 )<BR/><FONT POINT-SIZE="10">Tag: 1</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
    n5 -> n6 [label="0"];
    n7 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7D6608"><FONT COLOR="#FFFFFF"><B>q12</B></FONT></TD></TR><TR><TD BGCOLOR="#FEF9E7">sqrt2 *1/2 + i * ( -3/8 )<BR/><FONT POINT-SIZE="10">Tag: 1</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
    n5 -> n7 [label="1"];
    n8 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#2C3E50"><FONT COLOR="#FFFFFF"><B>q3</B></FONT></TD></TR><TR><TD BGCOLOR="#EBF5FB">L1<BR/><FONT POINT-SIZE="10">Tag: 1</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
    n9 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#2C3E50"><FONT COLOR="#FFFFFF"><B>q4</B></FONT></TD></TR><TR><TD BGCOLOR="#EBF5FB">L2<BR/><FONT POINT-SIZE="10">Tag: 4</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
    n8 -> n9 [label="0"];
    n10 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7D6608"><FONT COLOR="#FFFFFF"><B>q13</B></FONT></TD></TR><TR><TD BGCOLOR="#FEF9E7">sqrt2 *1/4 + i * ( -1/4 )<BR/><FONT POINT-SIZE="10">Tag: 1</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
    n9 -> n10 [label="0"];
    n11 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7D6608"><FONT COLOR="#FFFFFF"><B>q14</B></FONT></TD></TR><TR><TD BGCOLOR="#FEF9E7">sqrt2 *-1/8<BR/><FONT POINT-SIZE="10">Tag: 1</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
    n9 -> n11 [label="1"];
    n12 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#2C3E50"><FONT COLOR="#FFFFFF"><B>q5</B></FONT></TD></TR><TR><TD BGCOLOR="#EBF5FB">L2<BR/><FONT POINT-SIZE="10">Tag: 4</FONT></TD></TR></TABLE>>, shape=none, fillcolor=none];
    n8 -> n12 [label="1"];
